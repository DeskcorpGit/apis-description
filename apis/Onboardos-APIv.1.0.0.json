  /v1/kyc/onboardings:
    get:
      summary: List Onboardings by Tenant
      tags:
        - Backoffice
      parameters:
        - name: tenant_id
          in: query
          required: false
          schema:
            type: string
          example: "{{tenant_id}}"
        - name: page
          in: query
          required: false
          schema:
            type: string
          example: "2"
        - name: limit
          in: query
          required: false
          schema:
            type: string
          description: max 100
          example: "20"
      responses:
        "200":
          description: Operação realizada com sucesso.
  /v1/kyc/onboardings/{onboarding_id}/reject:
    post:
      summary: Reject Onboarding
      tags:
        - Backoffice
      parameters:
        - name: onboarding_id
          in: path
          required: true
          schema:
            type: string
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
            example:
              reason: fraudulent documents
      responses:
        "200":
          description: Operação realizada com sucesso.
  /v1/kyc/onboardings/{onboarding_id}/approve:
    post:
      summary: Approve Onboarding
      tags:
        - Backoffice
      parameters:
        - name: onboarding_id
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: Operação realizada com sucesso.
  /v1/documents/neobiz/{entity_id}:
    get:
      summary: Get Entity Documents
      tags:
        - Backoffice
      parameters:
        - name: entity_id
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: Operação realizada com sucesso.
